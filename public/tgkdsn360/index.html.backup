<!-- ✅ GLOBAL QUIZ SCENE WATCHER - Single interval to manage all quiz visibility -->
<script>
(function() {
  'use strict';

  // Wait for scene to load before starting watcher
  document.addEventListener('DOMContentLoaded', function() {
    const scene = document.querySelector('a-scene');

    if (scene.hasLoaded) {
      startGlobalWatcher();
    } else {
      scene.addEventListener('loaded', startGlobalWatcher);
    }
  });

  function startGlobalWatcher() {
    console.log('🔄 Starting global quiz scene watcher');

    // Single interval manages all quiz visibility
    setInterval(() => {
      const quizScenes = [
        { id: 'scene2', button: 'scene2QuizButton', card: 'scene2QuizCard' },
        { id: 'scene4', button: 'scene4QuizButton', card: 'scene4QuizCard' },
        { id: 'scene11', button: 'scene11QuizButton', card: 'scene11QuizCard' }
      ];

      if (typeof currentSceneId === 'undefined') return;

      quizScenes.forEach(quiz => {
        const btn = document.getElementById(quiz.button);
        const card = document.getElementById(quiz.card);

        if (!btn || !card) return;

        if (currentSceneId === quiz.id) {
          // Show button only if quiz card is not visible
          if (!card.getAttribute('visible')) {
            btn.setAttribute('visible', 'true');
          }
        } else {
          // Hide everything when not in this scene
          btn.setAttribute('visible', 'false');
          card.setAttribute('visible', 'false');
          card.removeAttribute('raycaster');
        }
      });
    }, 300); // 300ms is faster and more responsive than 500ms
  }
})();
</script>

<script>
(function () {
  let started = false;

  document.addEventListener('click', function () {
    if (started) return;

    const bg = document.getElementById('bgMusic');
    const bm = document.getElementById('welcomeBM');
    const en = document.getElementById('welcomeEN');

    if (!bg || !bm || !en) return;

    // 🎵 Start background music (loop forever)
    bg.volume = 0.3;
    bg.loop = true;
    bg.play();

    // 🇲🇾 Play BM after 5 seconds
    setTimeout(() => {
      bm.volume = 1.0;
      bm.play();
    }, 5000);

    // 🇬🇧 When BM ends, play English
    bm.addEventListener('ended', () => {
      en.volume = 1.0;
      en.play();
    });

    started = true;
  });
})();
</script>


<!-- ========================================= -->
<!-- ZOOM FEATURE (ADDED) -->
<!-- ========================================= -->
<script>
// ZOOM FEATURE (ADDED) - FOV-based keyboard zoom
// Exposed globally for button controls
const ZoomControl = (function() {
  'use strict';

  const DEFAULT_FOV = 80;
  const MIN_FOV = 40;
  const MAX_FOV = 80;
  const ZOOM_STEP = 5;

  let camera;

  // Wait for scene to load
  document.addEventListener('DOMContentLoaded', function() {
    const scene = document.querySelector('a-scene');

    if (scene.hasLoaded) {
      initZoom();
    } else {
      scene.addEventListener('loaded', initZoom);
    }
  });

  function initZoom() {
    camera = document.getElementById('camera');
    if (!camera) {
      console.warn('ZOOM FEATURE: Camera element not found');
      return;
    }

    console.log('🔍 ZOOM FEATURE: Initialized (+ to zoom in, - to zoom out, 0 to reset)');

    // Add keyboard listener for zoom keys (does not override existing listeners)
    window.addEventListener('keydown', handleZoomKeydown);
  }

  function handleZoomKeydown(e) {
    if (!camera) return;

    // ZOOM FEATURE (ADDED) - Handle zoom keys
    if (e.key === '+' || e.key === '=') {
      zoomIn();
      e.preventDefault();
    } else if (e.key === '-' || e.key === '_') {
      zoomOut();
      e.preventDefault();
    } else if (e.key === '0') {
      resetZoom();
      e.preventDefault();
    }
  }

  // ZOOM FEATURE (ADDED) - Exposed zoom functions
  function zoomIn() {
    if (!camera) return;
    const currentFOV = camera.getAttribute('camera').fov || DEFAULT_FOV;
    const newFOV = Math.max(MIN_FOV, currentFOV - ZOOM_STEP);
    if (newFOV !== currentFOV) {
      camera.setAttribute('camera', 'fov', newFOV);
      console.log(`🔍 ZOOM IN: FOV changed to ${newFOV}`);
    }
  }

  function zoomOut() {
    if (!camera) return;
    const currentFOV = camera.getAttribute('camera').fov || DEFAULT_FOV;
    const newFOV = Math.min(MAX_FOV, currentFOV + ZOOM_STEP);
    if (newFOV !== currentFOV) {
      camera.setAttribute('camera', 'fov', newFOV);
      console.log(`🔍 ZOOM OUT: FOV changed to ${newFOV}`);
    }
  }

  function resetZoom() {
    if (!camera) return;
    camera.setAttribute('camera', 'fov', DEFAULT_FOV);
    console.log(`🔍 ZOOM RESET: FOV reset to ${DEFAULT_FOV}`);
  }

  // Expose public API
  return {
    zoomIn: zoomIn,
    zoomOut: zoomOut,
    reset: resetZoom
  };

})();
</script>
<!-- ========================================= -->
<!-- END ZOOM FEATURE (ADDED) -->
<!-- ========================================= -->

<!-- ========================================= -->
<!-- CONTROL BAR BUTTON HANDLERS (ADDED) -->
<!-- ========================================= -->
<script>
(function() {
  'use strict';

  let isMuted = false;

  // Wait for DOM to load
  document.addEventListener('DOMContentLoaded', function() {
    initControlButtons();
  });

  function initControlButtons() {
    // ZOOM BUTTONS (ADDED)
    const zoomInBtn = document.getElementById('zoomInBtn');
    const zoomOutBtn = document.getElementById('zoomOutBtn');
    const zoomResetBtn = document.getElementById('zoomResetBtn');

    if (zoomInBtn) {
      zoomInBtn.addEventListener('click', function(e) {
        e.stopPropagation();
        if (typeof ZoomControl !== 'undefined') {
          ZoomControl.zoomIn();
        }
      });
    }

    if (zoomOutBtn) {
      zoomOutBtn.addEventListener('click', function(e) {
        e.stopPropagation();
        if (typeof ZoomControl !== 'undefined') {
          ZoomControl.zoomOut();
        }
      });
    }

    if (zoomResetBtn) {
      zoomResetBtn.addEventListener('click', function(e) {
        e.stopPropagation();
        if (typeof ZoomControl !== 'undefined') {
          ZoomControl.reset();
        }
      });
    }

    // FLIP BOARD BUTTON (ADDED)
    const flipBoardBtn = document.getElementById('flipBoardBtn');
    if (flipBoardBtn) {
      flipBoardBtn.addEventListener('click', function(e) {
        e.stopPropagation();
        triggerFlipBoard();
      });
    }

    // FULLSCREEN BUTTON (ADDED)
    const fullscreenBtn = document.getElementById('fullscreenBtn');
    if (fullscreenBtn) {
      fullscreenBtn.addEventListener('click', function(e) {
        e.stopPropagation();
        toggleFullscreen();
      });
    }

    // Listen for fullscreen changes
    document.addEventListener('fullscreenchange', updateFullscreenIcon);
    document.addEventListener('webkitfullscreenchange', updateFullscreenIcon);
    document.addEventListener('mozfullscreenchange', updateFullscreenIcon);
    document.addEventListener('MSFullscreenChange', updateFullscreenIcon);

    console.log('🎮 CONTROL BAR: Button handlers initialized');
  }

  // FLIP BOARD BUTTON HANDLER (FIX: Only flip visible boards)
  function triggerFlipBoard() {
    const scene = document.querySelector('a-scene');
    if (!scene || !scene.hasLoaded) return;

    // Find all flip-board entities
    const flipBoards = document.querySelectorAll('[flip-board]');

    // Find the first visible flip-board
    for (let board of flipBoards) {
      const isVisible = board.getAttribute('visible');

      // Check if board is visible (visible by default in A-Frame, or explicitly true)
      if (isVisible === null || isVisible === true || isVisible === 'true') {
        const planes = board.querySelectorAll('a-plane');
        let hasVisiblePlane = false;

        planes.forEach(plane => {
          const planeVisible = plane.getAttribute('visible');
          // Planes are visible by default or explicitly set to true
          if (planeVisible === null || planeVisible === true || planeVisible === 'true') {
            hasVisiblePlane = true;
          }
        });

        // Trigger flip if board has visible planes
        if (hasVisiblePlane) {
          const flipComponent = board.components['flip-board'];
          if (flipComponent && typeof flipComponent.flip === 'function') {
            flipComponent.flip();
            console.log('🔄 FLIP BOARD: Triggered flip on visible board');
            return;
          }
        }
      }
    }

    console.log('🔄 FLIP BOARD: No visible flip-board found');
  }



function toggleFullscreen() {
  const root = document.documentElement;

  if (!isFullscreen()) {
    // ENTER fullscreen (entire page, not a-scene)
    if (root.requestFullscreen) {
      root.requestFullscreen();
    } else if (root.webkitRequestFullscreen) {
      root.webkitRequestFullscreen();
    } else if (root.mozRequestFullScreen) {
      root.mozRequestFullScreen();
    } else if (root.msRequestFullscreen) {
      root.msRequestFullscreen();
    }

    console.log('📺 FULLSCREEN: Enter page fullscreen');
  } else {
    // EXIT fullscreen
    if (document.exitFullscreen) {
      document.exitFullscreen();
    } else if (document.webkitExitFullscreen) {
      document.webkitExitFullscreen();
    } else if (document.mozCancelFullScreen) {
      document.mozCancelFullScreen();
    } else if (document.msExitFullscreen) {
      document.msExitFullscreen();
    }

    console.log('📺 FULLSCREEN: Exit fullscreen');
  }
}


  // Check if currently in fullscreen
  function isFullscreen() {
    return !!(
      document.fullscreenElement ||
      document.webkitFullscreenElement ||
      document.mozFullScreenElement ||
      document.msFullscreenElement
    );
  }

  // Update fullscreen icon based on state
  function updateFullscreenIcon() {
    const iconEnter = document.getElementById('fullscreenIconEnter');
    const iconExit = document.getElementById('fullscreenIconExit');

    if (isFullscreen()) {
      // Show exit icon
      if (iconEnter) iconEnter.style.display = 'none';
      if (iconExit) iconExit.style.display = 'block';
    } else {
      // Show enter icon
      if (iconEnter) iconEnter.style.display = 'block';
      if (iconExit) iconExit.style.display = 'none';
    }
  }

})();
</script>
<!-- ========================================= -->
<!-- END CONTROL BAR BUTTON HANDLERS (ADDED) -->
<!-- ========================================= -->

<script>
(function () {
  let muted = false;

  const bg = document.getElementById('bgMusic');
  const bm = document.getElementById('welcomeBM');
  const en = document.getElementById('welcomeEN');

  const soundBtn = document.getElementById('soundBtn');
  const iconOn = document.getElementById('soundIconOn');
  const iconOff = document.getElementById('soundIconOff');

  if (!soundBtn) return;

  soundBtn.addEventListener('click', function (e) {
    e.stopPropagation();

    muted = !muted;

    // 🔇 mute / 🔊 unmute
    if (bg) bg.volume = muted ? 0 : 0.3;
    if (bm) bm.volume = muted ? 0 : 1.0;
    if (en) en.volume = muted ? 0 : 1.0;

    // change icon
    if (iconOn) iconOn.style.display = muted ? 'none' : 'block';
    if (iconOff) iconOff.style.display = muted ? 'block' : 'none';

    soundBtn.classList.toggle('muted', muted);
  });
})();
</script>


</body>
</html>
