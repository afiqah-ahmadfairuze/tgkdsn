function sparkleEffect(el) {
  if (!el) return;

  el.setAttribute('animation__pop', {
    property: 'scale',
    from: '1 1 1',
    to: '1.06 1.06 1',
    dur: 180,
    easing: 'easeOutQuad'
  });

  el.setAttribute('animation__glow', {
    property: 'material.color',
    from: '#228B22',
    to: '#7CFC00',
    dur: 250,
    dir: 'alternate',
    loop: 2
  });

  setTimeout(() => {
    el.setAttribute('scale', '1 1 1');
    el.removeAttribute('animation__pop');
    el.removeAttribute('animation__glow');
  }, 500);
}

