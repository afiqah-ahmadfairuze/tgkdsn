<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>360° Virtual Tour</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <!-- A-Frame -->
  <script src="https://aframe.io/releases/1.5.0/aframe.min.js"></script>

  <style>
    body {
      margin: 0;
      overflow: hidden;
      font-family: 'Comic Sans MS', 'Chalkboard SE', 'Arial Rounded MT Bold', cursive, sans-serif;
    }

    .a-enter-vr-button {
  display: none !important;
}

    /* UPDATED CONTROL BAR (MODIFIED) - Frosted glass effect with fullscreen support */
    .control-info {
      position: fixed;
      bottom: 0;
      left: 50%;
      transform: translateX(-50%);
      background: rgba(255, 255, 255, 0.9);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      color: #000;
      padding: 10px 20px;
      display: flex;
      justify-content: center;
      align-items: center;
      flex-wrap: nowrap;
      gap: 16px;
      z-index: 9999;
      border-radius: 12px 12px 0 0;
      box-shadow: 0 -2px 20px rgba(0, 0, 0, 0.15);
      pointer-events: none;
      font-weight: 800;
      font-size: 13px;
      white-space: nowrap;
    }

    /* FULLSCREEN SUPPORT (ADDED) - Control bar visible in fullscreen */
    body:fullscreen .control-info,
    body:-webkit-full-screen .control-info,
    body:-moz-full-screen .control-info,
    body:-ms-fullscreen .control-info,
    a-scene:fullscreen ~ .control-info,
    a-scene:-webkit-full-screen ~ .control-info,
    a-scene:-moz-full-screen ~ .control-info,
    a-scene:-ms-fullscreen ~ .control-info {
      position: fixed !important;
      bottom: 0 !important;
      left: 50% !important;
      transform: translateX(-50%) scale(3) !important;
      transform-origin: bottom center;
      z-index: 999999 !important;
      display: flex !important;
    }

    /* CONTROL BAR ITEMS (MODIFIED) - Single line layout */
    .control-item {
      display: flex;
      align-items: center;
      gap: 6px;
      font-weight: 800;
      color: #000;
      white-space: nowrap;
    }

    .control-separator {
      width: 1px;
      height: 20px;
      background: rgba(0, 0, 0, 0.25);
      flex-shrink: 0;
    }

    /* CONTROL BUTTONS (MODIFIED) - Icon buttons */
    .control-btn {
      pointer-events: auto;
      background: rgba(0, 0, 0, 0.08);
      border: 2px solid rgba(0, 0, 0, 0.25);
      border-radius: 6px;
      padding: 5px 10px;
      cursor: pointer;
      font-size: 14px;
      transition: all 0.2s ease;
      font-weight: 800;
      color: #000;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 4px;
      line-height: 1;
    }

    .control-btn:hover {
      background: rgba(0, 0, 0, 0.15);
      transform: scale(1.05);
    }

    .control-btn:active {
      transform: scale(0.95);
    }

    /* SVG ICONS (ADDED) - Universal cross-platform icons */
    .icon-svg {
      width: 16px;
      height: 16px;
      fill: currentColor;
      flex-shrink: 0;
    }

    .icon-svg-small {
      width: 14px;
      height: 14px;
      fill: currentColor;
      flex-shrink: 0;
    }

    /* Button Color Customization */
    #zoomInBtn {
      background: rgba(0, 255, 0, 0.3);
      border-color: rgba(0, 200, 0, 0.6);
    }

    #zoomInBtn:hover {
      background: rgba(0, 255, 0, 0.5);
    }

    #zoomOutBtn {
      background: rgba(255, 165, 0, 0.3);
      border-color: rgba(255, 140, 0, 0.6);
    }

    #zoomOutBtn:hover {
      background: rgba(255, 165, 0, 0.5);
    }

    #zoomResetBtn {
      background: rgba(0, 0, 255, 0.3);
      border-color: rgba(0, 0, 200, 0.6);
      color: #fff;
    }

    #zoomResetBtn:hover {
      background: rgba(0, 0, 255, 0.5);
    }

    #flipBoardBtn {
      background: rgba(128, 0, 128, 0.3);
      border-color: rgba(100, 0, 100, 0.6);
    }

    #flipBoardBtn:hover {
      background: rgba(128, 0, 128, 0.5);
    }

    #fullscreenBtn {
      background: rgba(255, 255, 0, 0.3);
      border-color: rgba(200, 200, 0, 0.6);
    }

    #fullscreenBtn:hover {
      background: rgba(255, 255, 0, 0.5);
    }

    #soundBtn {
      background: rgba(0, 255, 0, 0.3);
      border-color: rgba(0, 200, 0, 0.6);
    }

    #soundBtn:hover {
      background: rgba(0, 255, 0, 0.5);
    }

    #soundBtn.muted {
      background: rgba(255, 0, 0, 0.3);
      border-color: rgba(200, 0, 0, 0.6);
    }

    #soundBtn.muted:hover {
      background: rgba(255, 0, 0, 0.5);
    }
  </style>
</head>

<body>

<!-- ✅ FIX: REGISTER keyboard-look BEFORE <a-scene> -->
<script>
AFRAME.registerComponent('keyboard-look', {
  schema: {
    speed: { type: 'number', default: 0.03 }
  },

  init: function () {
    this.keys = {};
    this.lookControls = null;

    window.addEventListener('keydown', (e) => {
      if (e.key.startsWith('Arrow')) {
        e.preventDefault();
        this.keys[e.key] = true;
      }
    });

    window.addEventListener('keyup', (e) => {
      if (e.key.startsWith('Arrow')) {
        this.keys[e.key] = false;
      }
    });
  },

  tick: function () {
    if (!this.lookControls) {
      this.lookControls = this.el.components['look-controls'];
      if (!this.lookControls) return;
    }

    const yaw = this.lookControls.yawObject.rotation;
    const pitch = this.lookControls.pitchObject.rotation;
    const speed = this.data.speed;

    if (this.keys['ArrowLeft'])  yaw.y += speed;
    if (this.keys['ArrowRight']) yaw.y -= speed;
    if (this.keys['ArrowUp'])    pitch.x += speed;
    if (this.keys['ArrowDown'])  pitch.x -= speed;

    pitch.x = Math.max(-Math.PI / 2, Math.min(Math.PI / 2, pitch.x));
  }
});

// ✅ FLIP-BOARD COMPONENT
AFRAME.registerComponent('flip-board', {
  schema: {
    frontSrc: { type: 'string', default: '' },
    backSrc: { type: 'string', default: '' },
    width: { type: 'number', default: 1 },
    height: { type: 'number', default: 1 },
    duration: { type: 'number', default: 800 }
  },

  init: function () {
    console.log('🎴 Flip-board component initialized');
    this.isFlipped = false;
    this.isAnimating = false;

    // Get base rotation from element (set by SceneManager)
    const baseRotation = this.el.getAttribute('rotation');
    this.baseRotationY = baseRotation ? baseRotation.y : 0;
    this.currentRotation = this.baseRotationY;
    console.log('🎴 Base rotation Y:', this.baseRotationY);

    // Create front plane
    const frontPlane = document.createElement('a-plane');
    frontPlane.setAttribute('src', this.data.frontSrc);
    frontPlane.setAttribute('width', this.data.width);
    frontPlane.setAttribute('height', this.data.height);
    frontPlane.setAttribute('material', 'shader: flat; transparent: true');
    frontPlane.setAttribute('rotation', '0 0 0');
    frontPlane.classList.add('clickable'); // Make clickable for raycaster
    this.el.appendChild(frontPlane);
    this.frontPlane = frontPlane;

    // Create back plane (rotated 180° so it faces opposite direction)
    const backPlane = document.createElement('a-plane');
    backPlane.setAttribute('src', this.data.backSrc);
    backPlane.setAttribute('width', this.data.width);
    backPlane.setAttribute('height', this.data.height);
    backPlane.setAttribute('material', 'shader: flat; transparent: true');
    backPlane.setAttribute('rotation', '0 180 0');
    backPlane.classList.add('clickable'); // Make clickable for raycaster
    this.el.appendChild(backPlane);
    this.backPlane = backPlane;

    // Click handler on both planes (since click might not bubble from child to parent)
    const clickHandler = () => {
      if (this.isAnimating) return;
      this.flip();
    };

    frontPlane.addEventListener('click', clickHandler);
    backPlane.addEventListener('click', clickHandler);
    this.el.addEventListener('click', clickHandler);

    console.log('🎴 Click handlers attached to front plane, back plane, and container');
  },

  flip: function () {
    console.log('🔄 Flip triggered!');
    this.isAnimating = true;
    this.isFlipped = !this.isFlipped;

    // Rotate container 180° to reveal the other side
    this.currentRotation += 180;
    console.log('🔄 Rotating to:', this.currentRotation);

    this.el.setAttribute('animation', {
      property: 'rotation.y',
      to: this.currentRotation,
      dur: this.data.duration,
      easing: 'easeInOutCubic'
    });

    // Reset animation state
    setTimeout(() => {
      this.isAnimating = false;
      this.el.removeAttribute('animation');
    }, this.data.duration);
  }
});
</script>

<a-scene cursor="rayOrigin: mouse">

  <!-- ✅ ALL YOUR ASSETS — UNCHANGED -->
  <a-assets>
    <img id="info-houselayout" src="Assets/images/infoboards/houselayout.png">

    <img id="info-kawas-front" src="Assets/images/infoboards/kawas-front.png">
    <img id="info-kawas-back" src="Assets/images/infoboards/kawas-back.png">

    <img id="info-olod-front" src="Assets/images/infoboards/olod-front.png">
    <img id="info-olod-back" src="Assets/images/infoboards/olod-back.png">

    <img id="info-soliu-front" src="Assets/images/infoboards/soliu-front.png">
    <img id="info-soliu-back" src="Assets/images/infoboards/soliu-back.png">

    <img id="info-soriba-front" src="Assets/images/infoboards/soriba-front.png">
    <img id="info-soriba-back" src="Assets/images/infoboards/soriba-back.png">

    <img id="info-tilud-front" src="Assets/images/infoboards/tilud-front.png">
    <img id="info-tilud-back" src="Assets/images/infoboards/tilud-back.png">

    <img id="nadir-patch" src="Assets/images/tgkdsn-patch360.jpg">

    <audio id="bgMusic" src="Assets/audio/background.mp3" loop></audio>
    <audio id="welcomeBM" src="Assets/audio/welcome-bm.mp3"></audio>
    <audio id="welcomeEN" src="Assets/audio/welcome-eng.mp3"></audio>

  </a-assets>

  <!-- Camera (FIX: Explicit FOV for consistent zoom reset) -->
  <a-camera
    id="camera"
    camera="fov: 80"
    position="0 0 0"
    wasd-controls="enabled: false"
    look-controls="enabled: true"
    keyboard-look>
    <a-cursor
      color="#39FF14"
raycaster="objects: .clickable"
      material="shader: flat">
    </a-cursor>
  </a-camera>

  <a-entity id="hotspotContainer"></a-entity>

  <a-entity id="scene2QuizContainer">

    <!-- Quiz Button (visible only in Scene 2) -->
    <a-image
      id="scene2QuizButton"
      src="Assets/images/quiz-icon.png"
      width="1.2"
      height="1.2"
      position="5.0 0.4 -2"
      rotation="0 -10 0"
      material="transparent: true; alphaTest: 0.5; side: double"
      visible="false"
      class="clickable">
    </a-image>

    <!-- Quiz Card (same position/rotation as Scene 2 infoboard) -->
    <a-entity
      id="scene2QuizCard"
      position="2.3 0.4 -3"
      rotation="0 -10 0"
      visible="false">

      <!-- Background -->
      <a-plane
        width="5.2"
        height="3.25"
        color="#2f5d1e"
        material="shader: flat">
      </a-plane>

      <!-- Question Title (BM) -->
      <a-text
        value="Mengapa alat seperti Dangol dan Pongorob digantung?"
        align="center"
        color="#FFD700"
        width="5.0"
        position="0 1.35 0.01"
        wrap-count="50">
      </a-text>

      <!-- Question Title (EN) -->
      <a-text
        value="Why are tools like Dangol and Pongorob hung?"
        align="center"
        color="#FFD700"
        width="4.0"
        position="0 1.05 0.01"
        wrap-count="45">
      </a-text>

      <!-- Answer A -->
      <a-plane
        id="scene2AnswerA"
        width="4.8"
        height="0.5"
        position="0 0.5 0.01"
        color="#1a3d11"
        material="shader: flat"
        class="clickable quiz-answer">
        <a-text
          value="A. Supaya nampak cantik\n   So that they look nice"
          align="left"
          color="#FFFFFF"
          width="4.3"
          position="-2.3 0 0.01"
          wrap-count="50">
        </a-text>
      </a-plane>

      <!-- Answer B (CORRECT) -->
      <a-plane
        id="scene2AnswerB"
        width="4.8"
        height="0.5"
        position="0 -0.1 0.01"
        color="#1a3d11"
        material="shader: flat"
        class="clickable quiz-answer">
        <a-text
          value="B. Supaya mudah diambil dan selamat\n   So they are easy to take and safe"
          align="left"
          color="#FFFFFF"
          width="4.3"
          position="-2.3 0 0.01"
          wrap-count="50">
