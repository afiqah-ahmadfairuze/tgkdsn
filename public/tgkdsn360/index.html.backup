  </a-entity>

</a-scene>

<!-- FIX: Control bar placed AFTER <a-scene> for fullscreen support -->
<!-- UPDATED CONTROL BAR (MODIFIED) - Universal SVG icons for cross-platform compatibility -->
<div class="control-info">
  <!-- Look Controls -->
  <div class="control-item">
    <svg class="icon-svg" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
      <path d="M12 2L8 6h3v5H6V8L2 12l4 4v-3h5v5H8l4 4 4-4h-3v-5h5v3l4-4-4-4v3h-5V6h3z"/>
    </svg>
    <span>Look</span>
  </div>

  <div class="control-separator"></div>

  <!-- Mouse Drag -->
  <div class="control-item">
    <svg class="icon-svg" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
      <path d="M13 1.07V9h7c0-4.08-3.05-7.44-7-7.93zM4 15c0 4.42 3.58 8 8 8s8-3.58 8-8v-4H4v4zm7-13.93C7.05 1.56 4 4.92 4 9h7V1.07z"/>
    </svg>
    <span>Drag</span>
  </div>

  <div class="control-separator"></div>

  <!-- Zoom Controls (ADDED) -->
  <div class="control-item">
    <button id="zoomInBtn" class="control-btn" title="Zoom In (+)">
      <svg class="icon-svg-small" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
        <path d="M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z"/>
      </svg>
    </button>
    <button id="zoomOutBtn" class="control-btn" title="Zoom Out (-)">
      <svg class="icon-svg-small" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
        <path d="M19 13H5v-2h14v2z"/>
      </svg>
    </button>
    <button id="zoomResetBtn" class="control-btn" title="Reset Zoom (0)">0</button>
    <span>Zoom</span>
  </div>

  <div class="control-separator"></div>

  <!-- Flip Board Control (ADDED) -->
  <div class="control-item">
    <button id="flipBoardBtn" class="control-btn" title="Flip Info Board">
